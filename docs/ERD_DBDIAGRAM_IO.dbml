Ref: RetinalImage.AiScreeningId > AiScreening.Id
Ref: ScreeningResult.AiScreeningId > AiScreening.Id
Ref: Consent.AiScreeningId > AiScreening.Id
Ref: Consent.PatientId > Patient.Id
Ref: ConsultationSession.PatientId > Patient.Id
Ref: ConsultationSession.OphthalmologistId > Ophthalmologist.Id
Ref: ConsultationSession.OrganisationId > Organisation.Id
Ref: ConsultationSession.AiScreeningId > AiScreening.Id
Ref: ConsultationSession.AppointmentSlotId > AppointmentSlot.Id
Ref: Conversation.OphthalmologistId > Ophthalmologist.Id
Ref: Conversation.ConsultationSessionId > ConsultationSession.Id
Ref: ChatMessage.ConversationId > Conversation.Id
Ref: MedicalDiagnosis.AiScreeningId > AiScreening.Id
Ref: MedicalDiagnosis.ConsultationSessionId > ConsultationSession.Id
Ref: PatientRoadmap.PatientId > Patient.Id
Ref: PatientRoadmap.MedicalDiagnosisId > MedicalDiagnosis.Id
Ref: AppointmentSlot.ScheduleTemplateId > ScheduleTemplate.Id
Ref: Appointment.PatientId > Patient.Id
Ref: Appointment.AppointmentSlotId > AppointmentSlot.Id
Ref: Appointment.OrganisationId > Organisation.Id
Ref: Appointment.DoctorId > Ophthalmologist.Id
Ref: Appointment.ConsultationSessionId > ConsultationSession.Id
Ref: WebsiteFeedback.PatientId > Patient.Id
Ref: OrganisationFeedback.PatientId > Patient.Id
Ref: OrganisationFeedback.OrganisationId > Organisation.Id
Ref: OrganisationFeedback.AppointmentId > Appointment.Id
Ref: OphthalmologistFeedback.PatientId > Patient.Id
Ref: OphthalmologistFeedback.OphthalmologistId > Ophthalmologist.Id
Ref: OphthalmologistFeedback.ConsultationSessionId > ConsultationSession.Id
Ref: OphthalmologistLeaveRequest.OphthalmologistId > Ophthalmologist.Id
Ref: OphthalmologistEmploymentTypeChangeRequest.OphthalmologistId > Ophthalmologist.Id
Ref: RefreshToken.UserId > AspNetUsers.Id
Ref: RolePermission.RoleId > AspNetRoles.Id
Ref: RolePermission.PermissionId > Permission.Id
Ref: UserPermission.PermissionId > Permission.Id
Ref: WalletTransaction.WalletId > Wallet.Id
Ref: DepositRequest.WalletId > Wallet.Id
Ref: WithdrawalRequest.WalletId > Wallet.Id
Ref: Payment.OrderId > Orders.Id
Ref: Contract.TemplateId > ContractTemplate.Id
Ref: ProfessionalPost.OriginalPostId > ProfessionalPost.Id
Ref: PostReaction.PostId > ProfessionalPost.Id
Ref: PostComment.PostId > ProfessionalPost.Id
Ref: PostComment.ParentCommentId > PostComment.Id
Ref: PostAttachment.PostId > ProfessionalPost.Id
Ref: SavedPost.PostId > ProfessionalPost.Id
