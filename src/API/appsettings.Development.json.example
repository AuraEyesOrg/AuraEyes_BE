{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "BaseUrl": "http://localhost:3000",
  "AiAsset": {
    "BaseUrl": "https://ai"
  },
  "Hangfire": {
    "ServerEnabled": false,
    "WorkerCount": 1
  },
  "RateLimiting": {
    "ReadPermitLimit": 120,
    "ReadWindowSeconds": 60,
    "ReadQueueLimit": 0,
    "WritePermitLimit": 60,
    "WriteWindowSeconds": 60,
    "WriteQueueLimit": 0,
    "SensitivePermitLimit": 8,
    "SensitiveWindowSeconds": 60,
    "SensitiveQueueLimit": 0
  },
  "BetterStack": {
    "Dashboard": {
      "EmbedUrl": ""
    },
    "Heartbeats": {
      "DailyQuotaReset": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "SlotMaintenance": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "SessionReminderWorker": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "ReservationExpirationWorker": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "ConsultationStateWorker": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      }
    }
  },
  "AdminNotifications": {
    "OrganisationOnboardingEmail": "systemadmin@gmail.com"
  }
}
