{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=AuraEyesDb;Username=postgres;Password=REPLACE_ME"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "AuraEyesAPI",
    "Audience": "AuraEyesClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewSeconds": 0
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "UseSsl": false,
    "UseStartTls": true,
    "FromName": "Aura Eyes System",
    "FromEmail": "noreply@auraeyes.com"
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 1
  },
  "RateLimiting": {
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 0,
    "AuthPermitLimit": 20,
    "AuthWindowSeconds": 60,
    "AuthQueueLimit": 0
  },
  "AdminNotifications": {
    "OrganisationOnboardingEmail": "systemadmin@gmail.com"
  },
  "AllowedHosts": "*"
}
