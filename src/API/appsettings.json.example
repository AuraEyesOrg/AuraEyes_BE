{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=AuraEyesDb;Username=postgres;Password=REPLACE_ME"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "AuraEyesAPI",
    "Audience": "AuraEyesClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ClockSkewSeconds": 0
  },
  "AiAsset": {
    "BaseUrl": "https://ai"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "UseSsl": false,
    "UseStartTls": true,
    "FromName": "Aura Eyes System",
    "FromEmail": "noreply@auraeyes.com"
  },
  "Hangfire": {
    "ServerEnabled": true,
    "WorkerCount": 1
  },
  "RateLimiting": {
    "ReadPermitLimit": 240,
    "ReadWindowSeconds": 60,
    "ReadQueueLimit": 0,
    "WritePermitLimit": 80,
    "WriteWindowSeconds": 60,
    "WriteQueueLimit": 0,
    "SensitivePermitLimit": 20,
    "SensitiveWindowSeconds": 60,
    "SensitiveQueueLimit": 0
  },
  "BetterStack": {
    "Dashboard": {
      "EmbedUrl": ""
    },
    "Heartbeats": {
      "DailyQuotaReset": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "SlotMaintenance": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "SessionReminderWorker": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "ReservationExpirationWorker": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      },
      "ConsultationStateWorker": {
        "PingUrl": "",
        "StartUrl": "",
        "FailUrl": ""
      }
    }
  },
  "AdminNotifications": {
    "OrganisationOnboardingEmail": "systemadmin@gmail.com"
  },
  "AllowedHosts": "*"
}
