faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  stage.static_labels {
    values = {
      "job" = "faro",
    }
  }

  // Thử mọi đường dẫn có thể có trong JSON của Faro để lấy tên App
  stage.json {
    expressions = {
      "app_v1" = "app.name",
      "app_v2" = "meta.app.name",
      "env_v1" = "app.environment",
      "env_v2" = "meta.app.environment",
    }
  }

  // Gán nhãn lần 1 (Ưu tiên các trường ở gốc JSON)
  stage.labels {
    values = {
      "app"          = "app_v1",
      "service_name" = "app_v1",
      "environment"  = "env_v1",
      "env"          = "env_v1",
    }
  }

  // Gán nhãn lần 2 (Nếu bản v1 trống, nó sẽ lấy từ meta)
  stage.labels {
    values = {
      "app"          = "app_v2",
      "service_name" = "app_v2",
      "environment"  = "env_v2",
      "env"          = "env_v2",
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
