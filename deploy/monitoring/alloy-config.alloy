logging {
  level  = "info"
  format = "logfmt"
}

faro.receiver "default" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs    = [loki.write.faro_only.receiver]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.write "faro_only" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    "job"          = "faro",
    "app"          = "auraeyes-frontend",
    "service_name" = "auraeyes-frontend",
    "environment"  = "production",
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
