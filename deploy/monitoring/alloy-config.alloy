faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  stage.static_labels {
    values = {
      "job" = "faro",
    }
  }

  // Faro gửi data lồng trong object 'meta'
  stage.json {
    expressions = {
      "app" = "meta.app.name",
      "service_name" = "meta.app.name",
      "env" = "meta.app.environment",
      "browser" = "meta.browser.name",
    }
  }

  stage.labels {
    values = {
      "app" = "app",
      "service_name" = "service_name",
      "environment" = "env",
      "browser_name" = "browser",
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
