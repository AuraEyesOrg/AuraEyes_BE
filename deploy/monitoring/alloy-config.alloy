faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  stage.static_labels {
    values = {
      "job" = "faro",
    }
  }

  // Bước 1: Parse toàn bộ JSON để lấy object 'meta'
  stage.json {
    expressions = {
      "meta_obj" = "meta",
      "kind"     = "kind",
    }
  }

  // Bước 2: Parse tiếp object 'meta' (dưới dạng chuỗi) để lấy app name và env
  stage.json {
    expressions = {
      "app_name" = "app.name",
      "app_env"  = "app.environment",
      "browser"  = "browser.name",
    }
    source = "meta_obj"
  }

  stage.labels {
    values = {
      "app"         = "app_name",
      "application" = "app_name",
      "service_name"= "app_name",
      "env"         = "app_env",
      "environment" = "app_env",
      "browser_name"= "browser",
      "kind"         = "kind",
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
