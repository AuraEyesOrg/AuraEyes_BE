faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  // Ép nhãn Job để phân biệt hẳn với API
  stage.static_labels {
    values = {
      "job" = "faro-frontend",
    }
  }

  // Bóc tách đơn giản nhất
  stage.json {
    expressions = {
      "app" = "meta.app.name",
      "env" = "meta.app.environment",
    }
  }

  // Ép nhãn App nếu nó bóc tách được, nếu không thì để trống để ta debug
  stage.labels {
    values = {
      "app"         = "app",
      "application" = "app",
      "env"         = "env",
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
