logging {
  level  = "info"
  format = "logfmt"
}

faro.receiver "default" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.process.faro_process.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_process" {
  forward_to = [loki.write.local.receiver]

  // Bước 1: Xóa nhãn service_name cũ (nếu có) để tránh bị unknown_service
  stage.label_drop {
    values = ["service_name", "service_instance_id"]
  }

  // Bước 2: Dán nhãn chuẩn cho Dashboard
  stage.static_labels {
    values = {
      "app" = "auraeyes-web",
      "kind" = "frontend",
      "environment" = "production",
      "service_name" = "auraeyes-web",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  // Thêm nhãn bảo hiểm ở tầng cuối cùng
  external_labels = {
    "app" = "auraeyes-web",
    "environment" = "production",
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
