logging {
  level  = "info"
  format = "logfmt"
}

// 1. Nhận dữ liệu từ Web (Sửa tên app cho khớp với frontend)
faro.receiver "default" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.write.faro_only.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// 2. Bộ ghi chuyên dụng (Dùng tên auraeyes-frontend)
loki.write "faro_only" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    "app" = "auraeyes-frontend",
    "service_name" = "auraeyes-frontend",
    "kind" = "frontend",
    "environment" = "production",
  }
}

// 3. Đẩy Traces sang Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
