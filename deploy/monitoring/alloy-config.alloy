faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  stage.static_labels {
    values = {
      "job" = "faro",
    }
  }

  // Bóc tách mọi ngóc ngách của JSON Faro
  stage.json {
    expressions = {
      "app_name" = "app.name",
      "meta_app_name" = "meta.app.name",
      "env_name" = "app.environment",
      "meta_env_name" = "meta.app.environment",
      "kind" = "kind",
    }
  }

  // Bước 1: Thử lấy từ gốc JSON
  stage.labels {
    values = {
      "app"          = "app_name",
      "service_name" = "app_name",
      "environment"  = "env_name",
      "env"          = "env_name",
    }
  }

  // Bước 2: Nếu gốc trống, lấy từ meta (Ghi đè nếu có)
  stage.labels {
    values = {
      "app"          = "meta_app_name",
      "service_name" = "meta_app_name",
      "environment"  = "meta_env_name",
      "env"          = "meta_env_name",
    }
  }

  // Bước 3: FALLBACK - Nếu vẫn trống (như trường hợp bạn đang bị service_name="faro")
  // Chúng ta sẽ gán giá trị mặc định cho Frontend nếu job là faro mà app vẫn trống
  stage.static_labels {
    values = {
      "app"          = "auraeyes-frontend",
      "service_name" = "auraeyes-frontend",
      "environment"  = "production",
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
