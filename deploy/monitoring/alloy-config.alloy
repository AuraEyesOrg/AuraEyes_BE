faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  // Trả về nhãn job cũ để Dashboard nhận data
  stage.static_labels {
    values = {
      "job" = "faro",
    }
  }

  // Bóc tách nhãn từ JSON của Faro (Dữ liệu đã được gộp vào gốc)
  stage.json {
    expressions = {
      "f_app" = "app.name",
      "f_env" = "app.environment",
    }
  }

  // Gán đúng các nhãn mà Dashboard của bạn đang yêu cầu
  stage.labels {
    values = {
      "app"          = "f_app",
      "service_name" = "f_app",
      "environment"  = "f_env",
      "env"          = "f_env", // Thêm cả env cho các dashboard khác
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
