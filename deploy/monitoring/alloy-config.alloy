logging {
  level  = "info"
  format = "logfmt"
}

// 1. Nhận dữ liệu từ Web (Logs, Traces, Metrics)
faro.receiver "default" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs    = [loki.write.faro_only.receiver]
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [prometheus.relabel.faro_metrics.receiver] // Bổ sung Metrics
  }
}

// 2. Xử lý Metrics từ Faro trước khi gửi sang Prometheus
prometheus.relabel "faro_metrics" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    target_label = "app"
    replacement  = "auraeyes-frontend"
  }
  rule {
    target_label = "service_name"
    replacement  = "auraeyes-frontend"
  }
}

// 3. Gửi Metrics sang Prometheus (Dùng remote_write)
prometheus.remote_write "mimir" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// 4. Bộ ghi chuyên dụng cho Logs
loki.write "faro_only" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {
    "app" = "auraeyes-frontend",
    "service_name" = "auraeyes-frontend",
    "kind" = "frontend",
    "environment" = "production",
  }
}

// 5. Đẩy Traces sang Tempo
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
