faro.receiver "integrations_faro" {
  server {
    listen_address = "0.0.0.0"
    listen_port = 12347
    cors_allowed_origins = ["*"]
  }
  output {
    logs   = [loki.process.faro_logs.receiver]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

loki.process "faro_logs" {
  forward_to = [loki.write.grafana_loki.receiver]

  // BƯỚC 1: ÉP NHÃN CỨNG (Không phụ thuộc vào bóc tách JSON)
  // Việc này đảm bảo Dashboard tìm là thấy ngay
  stage.static_labels {
    values = {
      "job"          = "faro",
      "app"          = "auraeyes-frontend",
      "service_name" = "auraeyes-frontend",
      "environment"  = "production",
      "env"          = "production",
    }
  }

  // BƯỚC 2: Bóc tách JSON (Nếu bóc được thì nó sẽ ghi đè lên các giá trị trên)
  stage.json {
    expressions = {
      "app_name" = "app.name",
      "meta_app_name" = "meta.app.name",
      "env_name" = "app.environment",
      "meta_env_name" = "meta.app.environment",
    }
  }

  stage.labels {
    values = {
      "app"          = "app_name",
      "service_name" = "app_name",
      "environment"  = "env_name",
    }
  }

  stage.labels {
    values = {
      "app"          = "meta_app_name",
      "service_name" = "meta_app_name",
      "environment"  = "meta_env_name",
    }
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
