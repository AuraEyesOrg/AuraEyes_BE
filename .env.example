# =====================================================================
# AuraEyes Production Environment Variables
# Copy this file to .env and fill in the values
# =====================================================================

# ── Database ─────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=<CHANGE_TO_STRONG_PASSWORD_32_CHARS>
DB_NAME=auraeyes

# ── pgAdmin (access via SSH tunnel only) ─────────────────────────────
PGADMIN_EMAIL=admin@auraeyes.site
PGADMIN_PASSWORD=<CHANGE_ME>

# ── API ──────────────────────────────────────────────────────────────
API_PORT=5060
DOCKER_IMAGE_NAME=your-dockerhub-username/auraeyes-api
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# ── Connection String (auto-connects to local 'db' container) ────────
# The host 'db' is the Docker service name from docker-compose.yml
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=auraeyes;Username=postgres;Password=<SAME_AS_DB_PASSWORD>;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;Connection Idle Lifetime=60;Connection Pruning Interval=10

# ── JWT ──────────────────────────────────────────────────────────────
JwtSettings__SecretKey=
JwtSettings__Issuer=AuraEyesAPI
JwtSettings__Audience=AuraEyesClient
JwtSettings__AccessTokenExpiryMinutes=60
JwtSettings__RefreshTokenExpiryDays=7
JwtSettings__ClockSkewSeconds=30

# ── SMTP ─────────────────────────────────────────────────────────────
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=Aura Eyes Support
Smtp__UseSsl=false
Smtp__UseStartTls=true

# ── CORS ─────────────────────────────────────────────────────────────
Cors__AllowedOrigins__0=https://auraeyes.site

# ── Swagger ──────────────────────────────────────────────────────────
Swagger__Username=
Swagger__Password=

# ── PayOS ────────────────────────────────────────────────────────────
PayOS__ClientId=
PayOS__ApiKey=
PayOS__ChecksumKey=
PayOS__DefaultReturnUrl=
PayOS__DefaultCancelUrl=
PayOS__PayoutClientId=
PayOS__PayoutApiKey=
PayOS__PayoutChecksumKey=

# ── Cloudinary Storage ───────────────────────────────────────────────
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=auraeyes

# ── Supabase Storage (Legacy) ────────────────────────────────────────
SupabaseStorage__Url=
SupabaseStorage__ServiceKey=
SupabaseStorage__BucketName=

# ── Google ───────────────────────────────────────────────────────────
GoogleAuth__ClientId=
GoogleMeet__ClientId=
GoogleMeet__ClientSecret=
GoogleMeet__RefreshToken=
GoogleMeet__CalendarId=primary
GoogleMeet__ApplicationName=AURA Telemedicine
GoogleMeet__DefaultDurationMinutes=30

# ── Admin Notifications ─────────────────────────────────────────────
AdminNotifications__OrganisationOnboardingEmail=

# ── SerpApi ──────────────────────────────────────────────────────────
SerpApi__ApiKey=
SerpApi__BaseUrl=https://serpapi.com/search.json

# ── Google AI Studio ─────────────────────────────────────────────────
GoogleAiStudio__ApiKey=

# ── BetterStack ──────────────────────────────────────────────────────
BetterStack__Dashboard__EmbedUrl=

# ── Hangfire ─────────────────────────────────────────────────────────
Hangfire__ServerEnabled=true
Hangfire__WorkerCount=1

# ── AI Asset ─────────────────────────────────────────────────────────
AiAsset__BaseUrl=

# ── BaseUrl (Frontend URL) ──────────────────────────────────────────
BaseUrl=

# ── Monitoring ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=
LOKI_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
